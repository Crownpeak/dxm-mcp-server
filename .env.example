# Crownpeak DXM credentials. Copy this file to `.env` and fill in real values.
# When all five are set, the server auto-authenticates on the first tool call.
# Leave them blank to authenticate later via a profile or via the `login` tool.

CMS_SERVER=cms.crownpeak.net
CMS_INSTANCE=YOUR_INSTANCE
CMS_USERNAME=your.email@example.com
CMS_PASSWORD=
CMS_API_KEY=

# HTTP transport only (npm run server:http / npm run server:readonly:http).
# Defaults shown. PORT must be a free TCP port. HOST must usually stay 127.0.0.1 —
# any other value exposes the credentials above to network callers.
# PORT=3000
# HOST=127.0.0.1

# Optional: where credential profiles are stored. Defaults to ~/.dxm-mcp/profiles.json.
# DXM_MCP_PROFILES_PATH=

# Optional: set to 1 to log every tool call and every DXM backend HTTP request/response to
# stderr. See "Debugging" in README.md.
# DXM_MCP_DEBUG=
